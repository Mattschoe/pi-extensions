{
  "name": "pi-skill-manager",
  "version": "0.1.0",
  "description": "A /skills browser for Pi that toggles a skill between visible and hidden by writing disable-model-invocation into its SKILL.md frontmatter, keeping it loadable on demand while it is out of the system prompt.",
  "type": "module",
  "license": "BSD-3-Clause",
  "author": "Matthias Schoenning Nielsen",
  "homepage": "https://github.com/Mattschoe/pi-extensions/tree/main/extensions/pi-skill-manager",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mattschoe/pi-extensions.git",
    "directory": "extensions/pi-skill-manager"
  },
  "bugs": {
    "url": "https://github.com/Mattschoe/pi-extensions/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "extension",
    "skills",
    "system-prompt",
    "tui"
  ],
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=20"
  }
}
